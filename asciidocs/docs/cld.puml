@startuml
left to right direction

class Trip {
    {static}-int lastId
    -int id <<get>>
    -LocalDate date <<get/set>>
    -HashSet<Condition> conditions <<get/set>>
    -double startKm <<get/set>>
    -double endKm <<get/set>>
    -String startCity <<get/set>>
    -String endCity <<get/set>>
    -String info <<get/set>>

    +Trip(LocalDate date, HashSet<Condition> conditions, double startKm, double endKm, String startCity, String endCity)
    +Trip(int id, LocalDate date, HashSet<Condition> conditions, double startKm, double endKm, String startCity, String endCity)
    +Trip(int id, LocalDate date, HashSet<Condition> conditions, double startKm, double endKm, String startCity, String endCity, String info)
    +Trip(LocalDate date, HashSet<Condition> conditions, double startKm, double endKm, String startCity, String endCity, String info)
    +Trip(Trip other)
    +addCondition(Condition condition)
    +String toString()
    +String toStringCSV()
    +{static}Trip parseFromCSV(String line)
    +boolean equals(Object o)
    +int hashCode()
    +int compareTo(Trip o)
}

class TripManager {
    {static}-ObservableList<Trip> trips
    -DatabaseConnection connection
    -FilteredList<Trip> filteredList
    -SortedList<Trip> sortedList
    -SimpleIntegerProperty countOfTrips

    +TripManager()
    +SimpleIntegerProperty getCountProperty()
    +loadTripsFromDB()
    +addTrip(Trip trip)
    +updateTrip(Trip trip, Trip old)
    +deleteTrip(Trip trip)
    +SortedList<Trip> getTripsSorted()
    +applyFilter(Predicate<Trip> tripPredicate)
    +setSortedListComparator(Sort val)
    +List<String> getCSV()
    +double getSumKilometers()
    +double getAverageKilometers()
    +int getTripsInMonth(Month month)
    +double getKilometerInDates(List<LocalDate> dates)
    +double getProgress(Measure measure)
    +int getRequiredKilometers(Measure measure)
    +clearTrips()
}

class DatabaseConnection {
    {static}-String URL

    +DatabaseConnection()
    +insertIntoDB(Trip trip)
    +List<Trip> getAllTrips()
    +updateTrip(Trip trip, Trip old)
    +deleteTrip(Trip trip)
    -defaultTables()
}

enum Condition {
    Day
    Night
    Rain
    Dry
    Wet
    Fog
    Snow
    Ice
    +String getValue()
}

enum Sort {
    NEW
    OLD
}

enum Measure {
    Normal
    L17
    +{static}int getValue(Measure measure)
}

Trip "1" --- "*" Condition : hat
TripManager "1" --- "*" Trip : verwaltet
TripManager "1" --- "1" DatabaseConnection : schreibt in
TripManager --- Sort : nutzt zum Sortieren
TripManager --- Measure : nutzt zum Berechnen des Fortschritts

@enduml
